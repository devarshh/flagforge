{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Worker": {
    "ScheduledChangePollSeconds": 15
  },
  "Retention": {
    "UsageDays": 90,
    "AuditDays": 365
  }
}
