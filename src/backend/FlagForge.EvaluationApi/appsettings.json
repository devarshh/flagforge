{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Evaluation": {
    "SnapshotTtlSeconds": 60,
    "UsageFlushSeconds": 30
  },
  "RateLimiting": {
    "SdkPermitsPerSecond": 20,
    "SdkBurst": 100
  },
  "Cors": {
    "AllowedOrigins": ""
  }
}
