{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "JwtIssuer": "flagforge",
    "JwtAudience": "flagforge",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshCookieSecure": true
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10
  }
}
