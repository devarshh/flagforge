{
  "name": "flagforge-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "apps/dashboard",
    "apps/demo"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:sdk": "npm run build -w packages/sdk",
    "build": "npm run build:sdk && npm run build -w apps/dashboard && npm run build -w apps/demo",
    "lint": "npm run build:sdk && eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "npm run build:sdk && npm run typecheck --workspaces",
    "test": "npm run build:sdk && npm run test --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
