# FlagForge local environment — DEVELOPMENT-ONLY VALUES.
#
# Docker Compose works without this file: every variable has a built-in development default.
# To use your own values, copy this file to .env (git-ignored) or run:
#
#   ./scripts/gen-dev-secrets.sh
#
# which copies it and replaces the JWT signing key and SQL Server SA password with random values.
# Never reuse these values outside a local machine.

# SQL Server container SA password (dev-only). Must satisfy SQL Server complexity rules.
MSSQL_SA_PASSWORD=FlagForge_Dev_Sql_2026

# HS256 signing key for dashboard access tokens (dev-only). At least 32 bytes.
JWT_SIGNING_KEY=dev-only-jwt-signing-key-replace-me-0123456789abcdef

# Seeded administrator (dev-only credentials).
FF_SEED_ADMIN_EMAIL=admin@flagforge.local
FF_SEED_ADMIN_PASSWORD=FlagForge!2026

# Demo data: acme-coffee project, editor/viewer users, flags, usage history.
FF_SEED_DEMO_DATA=true
FF_SEED_DEMO_USER_PASSWORD=FlagForge!2026

# SDK key for the acme-coffee development environment. SDK keys are public identifiers
# (they ship to browsers), so this is not a secret, but it is still configurable.
FF_SEED_DEMO_SDK_KEY=ffk_local_demo_key_for_development_only_000

# Extra browser origins allowed to call /sdk (comma-separated). Empty = same origin only.
CORS_ALLOWED_ORIGINS=

# Build metadata shown in the dashboard footer.
APP_VERSION=dev
APP_COMMIT=local

# OpenTelemetry export. Leave empty to disable exporters. With the observability profile:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_ENDPOINT=
